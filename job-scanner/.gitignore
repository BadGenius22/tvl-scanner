# Personal profile at the repo root — what "suitable" means to YOU stays out
# of git by default (the packaged default in src/job_scanner/data/ is tracked).
# In a private repo you may prefer to track it: delete this line if so.
/profile.yaml

# Scan artifacts — except the seen-state, which must persist between daily
# workflow runs for the 🆕 flag to mean anything.
/artifacts/*
!/artifacts/job_scan_state.json

__pycache__/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
.env
