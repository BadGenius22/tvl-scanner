# tvl-scanner non-secret config
#
# Secrets (API keys) are stored in `pass`, NOT here. See README.md "Setup".
# This file holds only non-sensitive defaults that the user may override locally.
# Copy to .env and edit.

# ---- API keys ----
# ETHERSCAN_API_KEY: required by scripts/bugscan.py and tier0_check.py
# ALCHEMY_API_KEY:   optional; scripts/lien_probe.py uses it as the primary
#                    ethereum RPC endpoint when set (empty = ignored)
# DUNE_API_KEY:      optional; ecosystem-wide source/event/bytecode searches
#                    (scripts/dune_sigscan.py, scripts/lien_family_scan.py)
# TYPESAFE_API_KEY:  optional; System One judgment layer for the triage scripts
#                    (flag_triage, semantic_family_scan, core_contract_score,
#                    bounty_value, delta_triage)
ETHERSCAN_API_KEY=
ALCHEMY_API_KEY=
DUNE_API_KEY=
TYPESAFE_API_KEY=

# ---- Pipeline thresholds ----
MIN_TVL_USD=100000
MAX_AGE_DAYS=365
MIN_UNIQUE_USERS_30D=50
MAX_CANDIDATES_PER_SOURCE=200

# ---- Chains in scope (comma-separated) ----
# v1 recommended:    solana,arbitrum,base
# v2 full coverage:  solana,arbitrum,base,ethereum,optimism,polygon,bsc
# Edge-match chains: solana,arbitrum,base (leverage-vault + Anchor/Noir strongholds)
CHAINS=solana,arbitrum,base,ethereum,optimism,polygon,bsc

# ---- Output paths (relative to repo root) ----
ARTIFACTS_DIR=artifacts
REPORTS_DIR=reports

# ---- Audit handoff directory (printed in report hints; portable across Linux/Mac) ----
AUDIT_DIR=~/audit

# ---- API endpoints (override only if an upstream moves) ----
GECKOTERMINAL_BASE=https://api.geckoterminal.com/api/v2
BIRDEYE_BASE=https://public-api.birdeye.so
DEFILLAMA_BASE=https://api.llama.fi
GITHUB_API_BASE=https://api.github.com
C4_CONTESTS_URL=https://code4rena.com/api/contests

# ---- HTTP behavior ----
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=3
HTTP_BACKOFF_SECONDS=2.0

# ---- Logging ----
LOG_LEVEL=INFO
