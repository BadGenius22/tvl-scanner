# tvl-scanner non-secret config
#
# Secrets (API keys) are stored in `pass`, NOT here. See README.md "Setup".
# This file holds only non-sensitive defaults that the user may override locally.
# Copy to .env and edit.

# ---- Pipeline thresholds ----
MIN_TVL_USD=100000
MAX_AGE_DAYS=365
MIN_UNIQUE_USERS_30D=50
MAX_CANDIDATES_PER_SOURCE=200

# ---- Chains in scope (comma-separated) ----
# v1 recommended: solana,arbitrum,base
# v2 expansion:   solana,arbitrum,base,ethereum,optimism,polygon,bsc
CHAINS=solana,arbitrum,base

# ---- Output paths (relative to repo root) ----
ARTIFACTS_DIR=artifacts
REPORTS_DIR=reports

# ---- API endpoints (override only if an upstream moves) ----
GECKOTERMINAL_BASE=https://api.geckoterminal.com/api/v2
BIRDEYE_BASE=https://public-api.birdeye.so
DEFILLAMA_BASE=https://api.llama.fi
GITHUB_API_BASE=https://api.github.com
C4_CONTESTS_URL=https://code4rena.com/api/contests

# ---- HTTP behavior ----
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=3
HTTP_BACKOFF_SECONDS=2.0

# ---- Logging ----
LOG_LEVEL=INFO
