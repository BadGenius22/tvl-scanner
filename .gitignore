__pycache__/
*.py[cod]
*.egg-info/
*.egg
.venv/
venv/
.env
.env.local
artifacts/*
reports/*
!artifacts/.gitkeep
!reports/.gitkeep
# Hand-written triage (not scanner output) is tracked; generated scans stay ignored.
# The directory rule is required — git will not descend into an ignored directory,
# so re-including the per-candidate records needs the parent un-ignored first.
!reports/*-triage.md
!reports/*-triage/
# Hand-maintained kill list consumed by --exclude-slugs-file. Tracked so the
# triage decisions behind it survive a fresh clone.
!reports/excluded-slugs.txt
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
.vscode/
.idea/
*.swp
*~
logs/
.agents/
